{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/ace5831e-be07-44e1-852c-41c343d144c8')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/ace5831e-be07-44e1-852c-41c343d144c8')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UK-PRD-SENTINEL-113 CyberArk Failed Password Attempt Detection",
        "description": "In this rule we're trying to capture logs from CyberArk for those accounts",
        "severity": "Low",
        "enabled": true,
        "query": "let watch = _GetWatchlist(\"wl_cyberark\");\r\nCommonSecurityLog\r\n| where TimeGenerated >= ago(1d)\r\n| where DeviceVendor contains \"Cyber-Ark\"\r\n| where Activity contains \"Failure:[CPM] Password Failed\"\r\n| where DestinationUserName contains \"-svc-\"\r\n| summarize  FailedAttempt = count() by DestinationUserName, FileType, FileName, OldFileID, DestinationUserPrivileges, TimeGenerated\r\n| project-rename UserName = DestinationUserName\r\n| join kind=leftouter (\r\n   watch\r\n   | extend SearchKey = Name  // Ensure case-insensitive comparison\r\n   | project SearchKey, Manager // Select relevant fields\r\n) on $left.UserName == $right.SearchKey\r\n| where isnotempty(Manager) // Exclude rows where Manager is empty\r\n| project UserName, FileType, FileName, OldFileID, DestinationUserPrivileges, TimeGenerated, FailedAttempt, Manager",
        "queryFrequency": "P1D",
        "queryPeriod": "P1D",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT5H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CredentialAccess"
        ],
        "techniques": [
          "T1110"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT8H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": null,
        "customDetails": {
          "Manager": "Manager"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "UserName"
              }
            ]
          },
          {
            "entityType": "File",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "FileName"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
