{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/4cc0d226-2c2b-4ec2-9e01-2081bb699b47')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/4cc0d226-2c2b-4ec2-9e01-2081bb699b47')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "QC - D - Fake password prompt",
        "description": "This detection attempts to detect malicious usage of OSAScript to capture credentials of a user on MacOS.\n- https://github.com/cedowens/MacShellSwift/blob/master/MacShellSwift/Sources/MacShellSwift/main.swift#L184\n- https://duo.com/blog/the-macos-phishing-easy-button-applescript-dangers\n- https://github.com/redcanaryco/atomic-red-team/blob/master/atomics/T1056.002/T1056.002.md#atomic-test-1---applescript---prompt-user-for-password\n",
        "severity": "Informational",
        "enabled": false,
        "query": "DeviceProcessEvents\n| where Timestamp >= ago(1h)\n| where FileName has \"osascript\"\n| where ProcessCommandLine has_all (\"-e\", \"display dialog\",\"hidden\")\n| where ProcessCommandLine has_any (\"Password\",\"Credential\",\"Security update\", \"System preferences\",\"passphrase\")\n",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT4H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CredentialAccess",
          "Execution"
        ],
        "techniques": [
          "T1056",
          "T1059"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT1H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "alertDetailsOverride": {},
        "customDetails": null,
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "AccountName"
              }
            ]
          },
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "DeviceName"
              }
            ]
          },
          {
            "entityType": "Process",
            "fieldMappings": [
              {
                "identifier": "CommandLine",
                "columnName": "ProcessCommandLine"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
