{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/403b43f2-72dd-4fd3-81b5-9d862d233adc')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/403b43f2-72dd-4fd3-81b5-9d862d233adc')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UK-PRD-SENTINEL-098 Sailpoint High amount of password reset attempts",
        "description": "Detect a high amount of password reset attempts to investigate compromised credentials from being used to access SailPoint",
        "severity": "Low",
        "enabled": true,
        "query": "let timeFrame = 1h;\r\nlet threshold = 5;\r\nSailPointLogs_CL\r\n//| where TimeGenerated >= ago(timeFrame)\r\n| where action_s == \"PasswordChange\"\r\n| summarize\r\n    StartTimeUtc = min(TimeGenerated),\r\n    EndTimeUtc = max(TimeGenerated),\r\n    ResetAttempts = count()\r\n    by status_s, target_name_s, name_s, actor_name_s\r\n| where ResetAttempts >= threshold\r\n| project\r\n    StartTimeUtc,\r\n    EndTimeUtc,\r\n    Activity= name_s,\r\n    Status = status_s,\r\n    TargetUser=target_name_s,\r\n    Actor = actor_name_s,\r\n    ResetAttempts",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT5H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CredentialAccess",
          "InitialAccess"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "alertDetailsOverride": null,
        "customDetails": null,
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "TargetUser"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
