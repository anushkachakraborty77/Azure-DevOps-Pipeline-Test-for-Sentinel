{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/30d6c48c-ed23-4a47-9697-85ed10fe4b15')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/30d6c48c-ed23-4a47-9697-85ed10fe4b15')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "QC - D - Network connection launched from msiexec",
        "description": "This query detects executions of msiexec.exe that then open a network connection over port 8080.\nRecommended Actions:\nAny results should be investigated deeper. Specifically, analysts should look for if the network connection was\nestablished to download the second stage payload.\nReferences:\n- Microsoft 365 Defender - Threats // Raspberry Robin worm\n- https://newsbeezer.com/netherlandseng/microsoft-warns-companies-about-raspberry-robin-worm-in-networks-computer-news/\n",
        "severity": "Informational",
        "enabled": false,
        "query": "DeviceProcessEvents\n| where Timestamp > ago(1h)\n| where FileName == \"msiexec.exe\" and ProcessCommandLine has_any ('http:', 'https:') and not(ProcessCommandLine has_any('.exe','.msi')) \n| where ProcessCommandLine has_any ('/q', '-q','-quiet','/quiet','/qn','-qn') \n| where ProcessCommandLine has \"8080\"\n",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT4H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Execution",
          "DefenseEvasion"
        ],
        "techniques": [
          "T1059",
          "T1218"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT1H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "alertDetailsOverride": {},
        "customDetails": null,
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "AccountName"
              }
            ]
          },
          {
            "entityType": "File",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "FileName"
              }
            ]
          },
          {
            "entityType": "Process",
            "fieldMappings": [
              {
                "identifier": "CommandLine",
                "columnName": "ProcessCommandLine"
              }
            ]
          },
          {
            "entityType": "Process",
            "fieldMappings": [
              {
                "identifier": "CommandLine",
                "columnName": "InitiatingProcessCommandLine"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
