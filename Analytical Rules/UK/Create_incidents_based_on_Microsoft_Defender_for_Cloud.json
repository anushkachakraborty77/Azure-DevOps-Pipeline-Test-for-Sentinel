        "enabled": true,
        "productFilter": "Azure Security Center",
        "severitiesFilter": [
          "Low",
          "Medium",
          "High"
        ],
        "displayNamesFilter": null,
        "displayNamesExcludeFilter": null,
        "alertRuleTemplateName": null
      }
    }
  ]
