{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/9a94d6ba-5e18-4874-8799-28a11888e126')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/9a94d6ba-5e18-4874-8799-28a11888e126')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "GO-PRD-SENTINEL-021 Password Spray Attack",
        "description": "",
        "severity": "Medium",
        "enabled": true,
        "query": "let TriggeredIPs =\r\nSecurityAlert\r\n| where DisplayName contains \"GO-PRD-SENTINEL-021 Password Spray Attack\"\r\n| where TimeGenerated >= ago(24h)\r\n| extend A = parse_json(Entities)\r\n| mvexpand A\r\n| extend IP = tostring(A.Address)\r\n| where isnotempty(IP)\r\n| summarize make_list(IP);\r\nlet interval = 15m;\r\nSecurityEvent1\r\n| where TimeGenerated > ago (interval)\r\n| where EventID == 4625 and AccountType == \"User\"\r\n| where isnotempty(TargetUserName) and isnotempty(IpAddress) \r\n| where Status in (\"0xc0000064\", \"0xc000006a\", \"0xc000006e\")\r\n| where IpAddress !in (TriggeredIPs)\r\n| summarize StartTime = min(TimeGenerated), EndTime = max(TimeGenerated), AccountsUsed = strcat_array(make_set(TargetUserName), \",\"), Matches = dcount(TargetUserName),MF=tostring(make_set(MF)[0]), make_set(Process), make_set(IpPort), make_set(Computer), make_set(AccountType), make_set(Activity) by IpAddress \r\n| where IpAddress != \"-\" and IpAddress != \"\"\r\n| where Matches >= 30 and EndTime - StartTime <= interval\r\n| extend IPCustomEntity = IpAddress, AccountCustomEntity = AccountsUsed\r\n| extend URLCustomEntity = MF",
        "queryFrequency": "P1D",
        "queryPeriod": "P1D",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT5H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": null,
        "customDetails": null,
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "AccountCustomEntity"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "IPCustomEntity"
              }
            ]
          },
          {
            "entityType": "URL",
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "URLCustomEntity"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
