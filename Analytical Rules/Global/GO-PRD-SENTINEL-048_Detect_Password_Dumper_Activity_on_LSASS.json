{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/cdf43990-7aa1-40c7-a50f-074f88c45eb2')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/cdf43990-7aa1-40c7-a50f-074f88c45eb2')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "GO-PRD-SENTINEL-048 Detect Password Dumper Activity on LSASS",
        "description": "https://github.com/Neo23x0/sigma/blob/master/rules/windows/builtin/win_susp_lsass_dump_generic.yml",
        "severity": "Medium",
        "enabled": true,
        "query": "let Account =\r\nSecurityAlert\r\n| where DisplayName contains \"GO-PRD-SENTINEL-048 Detect Password Dumper Activity on LSASS\"\r\n| where TimeGenerated >= ago(24h)\r\n| extend A = parse_json(Entities)\r\n| mvexpand A\r\n| extend Accounts = A.Name\r\n| where isnotempty(Accounts)\r\n| project Accounts;\r\nSecurityEvent\r\n| where EventID == \"4656\"\r\n| where ObjectName endswith \"lsass.exe\" \r\n| where AccessMask in ('0x40', '0x1400', '0x1000', '0x100000', '0x1410', '0x1010', '0x1438', '0x143a', '0x1418', '0x1f0fff', '0x1f1fff', '0x1f2fff', '0x1f3fff')\r\n| extend FileName = parse_path(ProcessName).Filename \r\n| where FileName  !in ('wmiprvse.exe', 'taskmgr.exe', 'procexp64.exe', 'procexp.exe', 'lsm.exe', 'csrss.exe', 'wininit.exe', 'vmtoolsd.exe') \r\n| extend AccountCustomEntity = Account, IPCustomEntity = IpAddress, HostCustomEntity = Computer ",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT10M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CredentialAccess"
        ],
        "techniques": [
          "T1003"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account",
              "IP",
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": null,
        "customDetails": null,
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "AccountCustomEntity"
              }
            ]
          },
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "HostCustomEntity"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "IPCustomEntity"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
