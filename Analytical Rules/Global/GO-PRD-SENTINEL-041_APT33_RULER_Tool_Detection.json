{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/dfe4b27a-d4f6-4dee-a722-3f0badcdc269')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/dfe4b27a-d4f6-4dee-a722-3f0badcdc269')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "GO-PRD-SENTINEL-041 APT33 RULER Tool Detection",
        "description": "Detects  APT33 Ruler tool. This tool can be used to enumerate Exchange user and dump the GAL (Global Address List).\n",
        "severity": "Medium",
        "enabled": true,
        "query": "let TriggeredIPs =\r\nSecurityAlert\r\n| where DisplayName contains \"GO-PRD-SENTINEL-041 APT33 RULER Tool Detection\"\r\n| where TimeGenerated >= ago(24h)\r\n| extend A = parse_json(Entities)\r\n| mvexpand A\r\n| extend IP = tostring(A.Address)\r\n| where isnotempty(IP)\r\n| summarize make_list(IP);\r\n\r\nlet ceflogs = CommonSecurityLog1\r\n| where TimeGenerated >ago(10m)\r\n| where RequestClientApplication contains \"ruler\";\r\n\r\nlet palogs=paloaltologs\r\n| where TimeGenerated >ago(10m)\r\n|  where SyslogMessage has \",THREAT,url,\"\r\n| where UserAgent contains \"ruler\";\r\n\r\nlet bclogs = bluecoat\r\n| where TimeGenerated >ago(10m)\r\n| where UserAgent contains \"ruler\";\r\n\r\nlet websenselogs=Websense \r\n| where TimeGenerated >ago(10m)\r\n| where UserAgent contains \"ruler\";\r\n\r\nceflogs|union palogs|union bclogs|union websenselogs\r\n| where SourceIP !in (TriggeredIPs)\r\n| extend AccountCustomEntity = SourceUserName\r\n| extend HostCustomEntity = HostName\r\n| extend IPCustomEntity = SourceIP\r\n| extend URLCustomEntity = RequestURL",
        "queryFrequency": "PT5H",
        "queryPeriod": "PT5H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CommandAndControl",
          "Discovery",
          "Exfiltration"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account",
              "Host",
              "IP",
              "URL"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": null,
        "customDetails": null,
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "AccountCustomEntity"
              }
            ]
          },
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "HostCustomEntity"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "IPCustomEntity"
              }
            ]
          },
          {
            "entityType": "URL",
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "URLCustomEntity"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
